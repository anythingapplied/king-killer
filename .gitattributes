# Line endings and encoding (Standards 14): text files are normalized to LF in the repository
* text=auto

# Shell scripts must keep LF to run on Linux and macOS
*.sh text eol=lf

# Migrations keep LF everywhere: sqlx checksums each file's bytes, so a CRLF
# copy on Windows would refuse to run against a database migrated from an LF
# copy (production builds on Linux), and the reverse.
king-killer-api/migrations/*.sql text eol=lf

# Binary files: never convert or diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary
